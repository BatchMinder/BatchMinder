# Server Port Configuration
PORT=5000

# MongoDB Connection String (Atlas Cluster or Local Instance)
# Example: mongodb+srv://username:password@cluster.mongodb.net/batchminder
# Example (Local): mongodb://localhost:27017/batchminder
MONGODB_URI=mongodb://username:password@host:port/batchminder?options

# Application Environment Mode (development / production)
NODE_ENV=development

# JSON Web Token Secret (Provide a long secure random string)
JWT_SECRET=your_super_secret_jwt_key_here

# JWT Expiration Lifetime
JWT_EXPIRES_IN=7d

# Cloudinary Credentials
